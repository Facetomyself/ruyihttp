include LICENSE README.md CHANGELOG.md THIRD_PARTY_NOTICES.md pyproject.toml
recursive-include ruyihttp *.py *.json *.pem *.dat
recursive-include ruyihttp/licenses *
recursive-include native/win_amd64 *.dll *.json
recursive-include native/darwin_arm64 *.dylib *.json *.md
recursive-include native/darwin_x86_64 *.dylib *.json *.md
recursive-include native/linux_x86_64 *.so *.json *.md
recursive-include native/linux_aarch64 *.so *.json *.md
recursive-include native *.md SHA256SUMS
recursive-include native/patches *.patch
recursive-include docs *.md
include docs/upstream-0.11.0-data.json ci/firefox_wire_reference.json
include docs/firefox-reference-receipts.json docs/firefox-h2-preface-receipts.json
include ci/*.py ci/*.sh ci/*.ps1 ci/firefox_reference_requirements.txt
include ci/masque_interop/main.go ci/masque_interop/go.mod ci/masque_interop/go.sum
recursive-include ci/baselines *.json
recursive-include tests *.py
recursive-include benchmarks *.py *.txt
recursive-include ci/firefox_wire_references *.json *.md
recursive-include ci/firefox_h2_preface_references *.json
recursive-include tools *.py *.md
global-exclude *.py[cod]
