diff --git a/native/necko_quic/src/body_abi.rs b/native/necko_quic/src/body_abi.rs
new file mode 100644
index 0000000..8c4c015
--- /dev/null
+++ b/native/necko_quic/src/body_abi.rs
@@ -0,0 +1,91 @@
+// Binary body data plane. Sessions remain bound to the JSON connection's owner thread.
+use std::cell::RefCell;
+use std::ffi::{CString, c_char};
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::ptr;
+use std::slice;
+use std::time::Instant;
+
+use crate::{stream_id, with_session};
+
+const BODY_LIMIT: usize = 65_536;
+const MAX_VARINT: u64 = (1 << 62) - 1;
+
+thread_local! {
+    static ERROR: RefCell<CString> = RefCell::new(CString::default());
+}
+
+fn report_error(message: &str) -> *const c_char {
+    ERROR.with(|slot| {
+        let mut error = slot.borrow_mut();
+        *error = CString::new(message).unwrap_or_default();
+        error.as_ptr()
+    })
+}
+
+fn run(body: impl FnOnce() -> Result<(), String>) -> *const c_char {
+    match catch_unwind(AssertUnwindSafe(body)) {
+        Ok(Ok(())) => ptr::null(),
+        Ok(Err(message)) => report_error(&message),
+        Err(_) => report_error("HTTP/3 body operation panicked"),
+    }
+}
+
+fn valid_args(stream: u64, data: *const u8, len: usize, count: *mut usize) -> bool {
+    stream <= MAX_VARINT && !data.is_null() && (1..=BODY_LIMIT).contains(&len)
+        && !count.is_null() && count.is_aligned()
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn necko_quic_body_abi_version() -> u32 {
+    1
+}
+
+// The caller supplies valid, non-overlapping storage and keeps it alive for the call.
+// No buffers are retained. NULL denotes success; error text is thread-local and
+// valid until the next body error on this thread. Outputs are valid on success only.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn necko_quic_body_write_v1(
+    handle: u64, stream: u64, data: *const u8, len: usize, count: *mut usize,
+) -> *const c_char {
+    run(|| {
+        if !valid_args(stream, data, len, count) {
+            return Err("Invalid HTTP/3 body write arguments".into());
+        }
+        let written = with_session(handle, |session| {
+            let data = unsafe { slice::from_raw_parts(data, len) };
+            session.client.send_data(stream_id(stream), data, Instant::now())
+                .map_err(|error| format!("{error:?}"))
+        })?;
+        if written > len {
+            return Err("Invalid HTTP/3 body write count".into());
+        }
+        unsafe { count.write(written) };
+        Ok(())
+    })
+}
+
+// Same contract as write; fin is exactly 0 or 1 on success.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn necko_quic_body_read_v1(
+    handle: u64, stream: u64, data: *mut u8, len: usize, count: *mut usize, fin: *mut u8,
+) -> *const c_char {
+    run(|| {
+        if !valid_args(stream, data.cast_const(), len, count) || fin.is_null() {
+            return Err("Invalid HTTP/3 body read arguments".into());
+        }
+        let (read, ended) = with_session(handle, |session| {
+            let data = unsafe { slice::from_raw_parts_mut(data, len) };
+            session.client.read_data(Instant::now(), stream_id(stream), data)
+                .map_err(|error| format!("{error:?}"))
+        })?;
+        if read > len {
+            return Err("Invalid HTTP/3 body read count".into());
+        }
+        unsafe {
+            count.write(read);
+            fin.write(u8::from(ended));
+        }
+        Ok(())
+    })
+}
